{
  "name": "@tawks/editor",
  "description": "Insights editor",
  "version": "0.0.0",
  "type": "module",
  "main": "src/lib/index.ts",
  "scripts": {
    "dev": "NODE_ENV=development vite dev --port 3009",
    "build:demo": "vite build",
    "build": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "test": "npm run check && vitest run",
    "e2e": "cypress open --e2e",
    "lint": "eslint . --ext .js,.ts,.svelte --ignore-path .gitignore",
    "prepublishOnly": "is-ci || npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@tiptap/core": "^3.9.1",
    "svelte": "^5.41.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.26.1",
    "@sveltejs/package": "^2.5.4",
    "@testing-library/svelte": "^5.2.8",
    "@tiptap/core": "^3.9.1",
    "@tiptap/extension-bubble-menu": "^3.9.1",
    "@tiptap/extension-text-style": "^3.9.1",
    "@tiptap/extension-file-handler": "^3.9.1",
    "@tiptap/extension-floating-menu": "^3.9.1",
    "@tiptap/pm": "^3.9.1",
    "@tiptap/starter-kit": "^3.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@tsconfig/svelte": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "classnames": "^2.5.1",
    "cypress": "^15.5.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.38.0",
    "eslint-config-pegasus": "^6.0.2",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-svelte": "^3.12.5",
    "happy-dom": "^20.0.8",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "@lucide/svelte": "^0.544.0",
    "prosemirror-model": "^1.25.4",
    "prosemirror-view": "^1.41.3",
    "sass": "^1.93.2",
    "svelte": "^5.41.3",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte-check": "^4.3.3",
    "svelte-eslint-parser": "^1.4.0",
    "svelte2tsx": "^0.7.45",
    "ts-jest": "^29.4.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "@tailwindcss/vite": "^4.1.4",
    "tailwindcss": "4.1.16",
    "vitest": "^4.0.2",
    "@tiptap/extension-image": "^3.9.1",
    "@tiptap/extension-link": "^3.9.1",
    "@tiptap/extension-mention": "^3.9.1",
    "@tiptap/extension-placeholder": "^3.9.1",
    "@tiptap/suggestion": "^3.9.1",
    "tippy.js": "^6.3.7"
  },
  "dependencies": {
    "dompurify": "^3.2.6"
  }
}
