import{test}from'node:test';import assert from'node:assert/strict';import{candyVanState}from'../src/party/candy-van-state.ts';import type{RoomView}from'../src/party/protocol.ts';
const fixture=()=>({phase:{name:'board'},board:{turn_seat:1,tokens:[{seat:0,space:0,health:3,resting:0,coins:30}],spaces:[{id:0,x:100,z:0}],candy_runs:[{seat:0,x:3,z:0}],candy_van:{x:0,z:0,price:15,range:4.5,phase:'visit',joined_seats:[0],bought_seats:[],remaining:15,can_buy:true,can_join:false}}})as unknown as RoomView;
test('any joined visitor may buy during another players paused turn',()=>{const room=fixture();assert.equal(candyVanState(room,0)?.canBuy,true);room.board!.candy_van!.can_buy=false;assert.equal(candyVanState(room,0)?.canBuy,false);room.board!.candy_van!.can_buy=true;room.phase={name:'map_finale'};assert.equal(candyVanState(room,0)?.canBuy,false);});
test('players must opt in during the offer; visiting is never automatic',()=>{const room=fixture(),van=room.board!.candy_van!;van.phase='offer';van.joined_seats=[];van.can_join=true;assert.equal(candyVanState(room,0)?.canJoin,true);assert.equal(candyVanState(room,0)?.canBuy,false);van.joined_seats=[0];assert.equal(candyVanState(room,0)?.canJoin,false);assert.match(candyVanState(room,0)!.status,/You’re in/);});
test('purchased stock cannot be bought twice',()=>{const room=fixture();room.board!.candy_van!.bought_seats=[0];assert.equal(candyVanState(room,0)?.canBuy,false);assert.match(candyVanState(room,0)!.status,/Candy collected/);});
test('compass distance follows the visitor, not the original frozen board location',()=>{const room=fixture();assert.equal(candyVanState(room,0)?.distance,3);room.board!.candy_runs![0].x=12;room.board!.candy_van!.can_buy=false;assert.equal(candyVanState(room,0)?.distance,12);assert.match(candyVanState(room,0)!.status,/Run to the van/);});
test('insufficient funds and knockouts never grant a purchase',()=>{const room=fixture();room.board!.tokens[0].coins=10;assert.equal(candyVanState(room,0)?.canBuy,false);assert.match(candyVanState(room,0)!.status,/^Need 5 more coins\b/);room.board!.tokens[0].coins=30;room.board!.tokens[0].health=0;assert.equal(candyVanState(room,0)?.canBuy,false);});
test('spectators and absent events have no action',()=>{const room=fixture();assert.equal(candyVanState(room,null),null);room.board!.candy_van=null;assert.equal(candyVanState(room,0),null);assert.equal(candyVanState(null,0),null);});
